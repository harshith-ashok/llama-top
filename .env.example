# Copy to .env to customise. Everything is optional.
LLAMATOP_PORT=3000
LLAMATOP_BIND=127.0.0.1
# Set to an empty value to skip auto-registering a local Ollama source.
DEFAULT_OLLAMA_URL=http://host.docker.internal:11434
# Required only if you run host agents on other machines.
AGENT_TOKEN=
RETENTION_DAYS=7
